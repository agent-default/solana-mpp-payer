# Local-only. Copy to .env; do not commit the copy.

MPP_HOME=data
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=data/keystore/id.json

# USDC base units (6 decimals). 0 refuses all spends.
SPEND_CEILING_RAW=0
ALLOW_MAINNET=0
LIVE_PAY=0

# Exact allowlisted recipient pubkey for solana/charge.
MPP_RECIPIENT=

# Optional opt-in integration target.
MPP_SELLER_URL=
